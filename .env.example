COMPOSE_PROJECT_NAME=template-fullstack
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://app:change-me-for-local-development@postgres:5432/app
DJANGO_SECRET_KEY=development-only-change-me-before-deploying-please
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
